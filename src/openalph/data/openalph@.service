# Canonical OpenAlph agent unit template — SINGLE SOURCE OF TRUTH.
#
# This file is the one the installer deploys and the one the test suite
# validates. It ships as package data (see pyproject.toml), so it is present
# on disk after `pip install` even in the `curl | sudo bash` path where no
# git checkout exists; `install.sh` step 7 copies it from the installed
# package rather than re-emitting a heredoc. `etc/openalph@.service` is a
# symlink to this file.
#
# Before v0.1.3 three divergent versions existed — this file (with an
# ExecStart that crash-looped), the installer's heredoc, and a third
# variant described in SECURITY.md — and only the broken one was tested.
[Unit]
Description=OpenAlph Agent - %i
After=network-online.target
Wants=network-online.target
# kdsn.292 anti-flap (SB ruling 2026-08-26): bound restart cycling so a
# crash-looping agent can never hammer external secret-resolution services
# fleet-wide. At most 5 starts per 10 minutes; past the burst the unit stays
# failed-but-stopped until an operator acts. One directive per key — the test
# suite parses this file with configparser strict=True (rejects duplicates).
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=oa-%i
Group=openalph
WorkingDirectory=/home/oa-%i
# `run` is required: the CLI's subparser is mandatory (cli.py `sub.required
# = True`), so a bare config path exits 2 and, with Restart=on-failure,
# restart-loops forever.
ExecStart=/usr/local/bin/openalph run %i
Restart=on-failure
# kdsn.292 anti-flap: 30s between restarts (was 5) — worst case ~6 start
# cycles per StartLimitIntervalSec instead of ~120.
RestartSec=30
# Both assignments on ONE Environment= directive. systemd accepts repeated
# Environment= lines, but the test suite parses this file with configparser in
# strict mode, where a repeated key is a DuplicateOptionError -- the installed
# unit used two lines and would have failed the suite that never ran against
# it. One directive with multiple assignments is equivalent and parseable.
Environment="PATH=/srv/openalph/shared/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin" "BD_ACTOR=oa-%i"

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=tmpfs
# The shared dir is group-writable (2770) by design, so it is bound
# read-write; only the agent's own home and the shared dir are exposed.
BindPaths=/home/oa-%i /srv/openalph/shared
# SEC-11: agents share Group=openalph and used to bind the WHOLE /etc/openalph
# read-only, so agent A could read agent B's config (and any inline api_key in
# it). The agent runtime only ever reads its own agents/%i.toml, so mask the
# agents directory with an empty tmpfs and bind ONLY this agent's file into it:
# sibling configs are then not present in the namespace at all -- kernel-
# enforced isolation, not a group-permission convention. The venv stays bound.
TemporaryFileSystem=/etc/openalph/agents
BindReadOnlyPaths=/etc/openalph/agents/%i.toml /opt/openalph-venv
PrivateTmp=yes
UMask=0027
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# SEC-10: additional isolation. The process runs as a non-root user, so it holds
# no capabilities; the empty bounding set makes that explicit and permanent.
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
ProtectHostname=yes
ProtectClock=yes
ProtectKernelLogs=yes
SystemCallArchitectures=native
# @system-service is an allowlist that already excludes @privileged/@obsolete/
# @mount etc.; kept to ONE line so the strict INI parser in test_systemd.py does
# not see a duplicate key (systemd would merge repeated SystemCallFilter lines).
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# NOTE: MemoryDenyWriteExecute is intentionally NOT set -- the agent's Node/
# Python tools need writable+executable pages (V8 JIT, ctypes) and would break.

[Install]
WantedBy=multi-user.target
